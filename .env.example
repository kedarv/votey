# Choose http (default) or socket.
SLACK_MODE=http

# HTTP webhook mode
CLIENT_ID=
CLIENT_SECRET=
SIGNING_SECRET=

# Socket Mode (required when SLACK_MODE=socket)
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...

# Omit to use SQLite at data/votey.db. Set for Postgres in production.
# DATABASE_URL=postgresql://localhost:5432/votey
