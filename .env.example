# Omit to use SQLite at data/votey.db. Set for Postgres in production.
# DATABASE_URL=postgresql://localhost:5432/votey
CLIENT_ID=
CLIENT_SECRET=
SIGNING_SECRET=
FLASK_ENV=development

# SLACK_MODE: "http" (default) for webhook/slash-command mode,
#             "socket" for Socket Mode (no public URL needed).
SLACK_MODE=http

# Required only for socket mode. Generate at:
# https://api.slack.com/apps/<app-id>/general → App-Level Tokens
# with the connections:write scope.
# SLACK_APP_TOKEN=xapp-...

# Required only for socket mode. The bot token for the single workspace.
# SLACK_BOT_TOKEN=xoxb-...
